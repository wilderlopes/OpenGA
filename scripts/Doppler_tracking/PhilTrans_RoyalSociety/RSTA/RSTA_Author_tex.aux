\@writefile{toc}{\contentsline {section}{\numberline {1}Insert A head here}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {(a)}Insert B head here}{1}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {i}Insert C head here}{1}{subsubsection.1.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Equations}{1}{section.2}\protected@file@percent }
\newlabel{1.1}{{2.1}{1}{Equations}{equation.2.1}{}}
\newlabel{1.2}{{2.2}{1}{Equations}{equation.2.2}{}}
\bibcite{1}{1}
\bibcite{2}{2}
\bibcite{3}{3}
\bibcite{4}{4}
\@writefile{toc}{\contentsline {section}{\numberline {3}Enunciations}{2}{section.3}\protected@file@percent }
\newlabel{T0.1}{{3.1}{2}{}{theorem.3.1}{}}
\newlabel{C2.2}{{3.1}{2}{}{condition.3.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Figures \& Tables}{2}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Insert figure caption here}}{2}{figure.1}\protected@file@percent }
\newlabel{fig_sim}{{1}{2}{Insert figure caption here}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces An Example of a Table}}{2}{table.1}\protected@file@percent }
\newlabel{table_example}{{1}{2}{An Example of a Table}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Conclusion}{2}{section.5}\protected@file@percent }
